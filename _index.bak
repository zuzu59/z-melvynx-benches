<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Qwen3-VL</title>
<style>
  :root{
    --bg:#0b0e13; --panel:#141a22; --line:#26303c; --text:#e7edf3;
    --muted:#8b95a3; --accent:#ff7a45; --accent2:#4db8ff; --ok:#3fb950;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--text);
    font-family:'Segoe UI',system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;overflow:hidden}
  #stage{position:fixed;inset:0}
  canvas{display:block;width:100%;height:100%;touch-action:none}

  .hud{position:fixed;top:12px;left:12px;display:flex;flex-direction:column;gap:10px;
    z-index:10;pointer-events:none}
  .brand{pointer-events:auto;background:linear-gradient(90deg,var(--accent),var(--accent2));
    -webkit-background-clip:text;background-clip:text;color:transparent;font-weight:800;
    font-size:22px;letter-spacing:.5px}
  .brand small{display:block;-webkit-text-fill-color:var(--muted);font-weight:600;
    font-size:11px;letter-spacing:2px;text-transform:uppercase}

  .panel{pointer-events:auto;background:rgba(20,26,34,.92);border:1px solid var(--line);
    border-radius:12px;padding:12px 14px;backdrop-filter:blur(8px);box-shadow:0 8px 30px rgba(0,0,0,.45);
    min-width:220px}
  .telem{display:flex;gap:18px;font-variant-numeric:tabular-nums}
  .telem div{display:flex;flex-direction:column;line-height:1.25}
  .telem .k{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
  .telem .v{font-size:18px;font-weight:700}
  .telem .v span{font-size:11px;color:var(--muted);font-weight:600}

  .controls{display:flex;gap:8px;flex-wrap:wrap;pointer-events:auto;margin-top:10px}
  button{cursor:pointer;border:1px solid var(--line);background:#202631;color:var(--text);
    padding:9px 16px;border-radius:9px;font-weight:700;font-size:13px;transition:.15s}
  button:hover{border-color:var(--accent2);transform:translateY(-1px)}
  #test{background:linear-gradient(90deg,var(--accent),var(--accent2));border:none;color:#0a1017}
  #test:hover{filter:brightness(1.06)}
  #test:disabled{opacity:.5;cursor:not-allowed;transform:none}

  .menuBtn{position:fixed;top:12px;right:12px;z-index:11}
  .settings{position:fixed;top:54px;right:12px;width:304px;z-index:10;
    background:rgba(20,26,34,.97);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;box-shadow:0 8px 30px rgba(0,0,0,.5);display:none}
  .settings.show{display:block}
  .settings h3{margin:0 0 12px;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--accent2)}
  .row{margin-bottom:12px}
  .row label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;color:var(--muted)}
  .row label b{color:var(--text)}
  input[type=range]{width:100%;accent-color:var(--accent)}
  .hint{font-size:10px;color:var(--muted);margin-top:6px;line-height:1.45}
  .badge{display:inline-block;font-size:10px;padding:2px 7px;border-radius:20px;
    background:#1f6feb33;color:var(--accent2);border:1px solid #1f6feb66;margin-left:6px}
  .fps{pointer-events:auto;font-size:10px;color:var(--muted);margin-top:6px;font-variant-numeric:tabular-nums}
</style>
</head>
<body>
<div id="stage">
  <canvas id="c"></canvas>
</div>

<div class="hud">
  <div class="brand">Qwen3-VL<small>Rigid-Body Car vs. Brick Wall</small></div>
  <div class="panel telem">
    <div><span class="k">Vitesse voiture</span><span class="v" id="tSpeed">0.0 <span>m/s</span></span></div>
    <div><span class="k">Temps</span><span class="v" id="tTime">0.00 <span>s</span></span></div>
    <div><span class="k">Briques en mouvement</span><span class="v" id="tMove">0 <span>/ 0</span></span></div>
  </div>
  <div class="controls">
    <button id="test">▶ Test</button>
    <button id="reset">↺ Reset</button>
  </div>
</div>

<div class="menuBtn"><button id="menuBtn">⚙ Réglages</button></div>

<div class="settings" id="settings">
  <h3>Réglages de l'expérience <span class="badge" id="runBadge">en pause</span></h3>
  <div class="row"><label>Vitesse voiture (m/s) <b id="vSpeed">22</b></label><input type="range" id="speed" min="5" max="45" step="1" value="22"></div>
  <div class="row"><label>Colonnes (largeur) <b id="vCol">12</b></label><input type="range" id="cols" min="4" max="24" step="1" value="12"></div>
  <div class="row"><label>Rangées (hauteur) <b id="vRow">8</b></label><input type="range" id="rows" min="3" max="16" step="1" value="8"></div>
  <div class="row"><label>Couches en profondeur <b id="vDepth">2</b></label><input type="range" id="depth" min="1" max="5" step="1" value="2"></div>
  <div class="row"><label>Masse brique (kg) <b id="vMass">2.5</b></label><input type="range" id="mass" min="0.5" max="12" step="0.1" value="2.5"></div>
  <div class="hint">Vitesse, colonnes, rangées, couches et masse sont réglables. La gravité (9.81 m/s²), le frottement de brique (0.72), la réstitution (0.18) et le frottement de sol (0.85) suivent les valeurs obligatoires du benchmark pour garantir des comparaisons reproductibles.</div>
  <div class="fps" id="fps"></div>
</div>

<script>
"use strict";
/* ============================================================
   Qwen3-VL — Rigid-Body Car vs. Brick Wall crash lab.
   Single-file, no dependencies.
   Real impulse-based rigid-body dynamics:
   - OBB (rotated-rectangle) collision via SAT with incident-face clipping
   - Sequential-impulse solver with Coulomb friction + restitution
   - Baumgarte positional correction
   - Ground handled as a static plane
   Every brick is an independent dynamic body; the wall collapses only
   because of genuine momentum transfer through real contacts. No scripted
   motion, no hidden randomness in the physics (deterministic).
   ============================================================ */

// ---- Mandatory benchmark defaults (SI units) ----
const DEFAULTS = {
  speed: 22, cols: 12, rows: 8, depth: 2, brickMass: 2.5,
  brickW: 0.50, brickH: 0.24, gravity: 9.81, brickFriction: 0.72,
  brickRestitution: 0.18, carMass: 1250, carW: 4.2, carH: 1.45,
  groundFriction: 0.85, scale: 80
};

// ---- Canvas ----
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d");
let VW = 0, VH = 0, DPR = 1;
function resize(){
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  VW = window.innerWidth; VH = window.innerHeight;
  canvas.width = VW * DPR; canvas.height = VH * DPR;
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
}
window.addEventListener("resize", resize);
resize();

// ---- Simulation state ----
let S = null;

// solver tuning (pixels-based)
const SUBSTEPS = 5;
const SOLVER_IT = 14;
const SLOP = 0.4;            // penetration slop (px)
const POS_FACTOR = 0.42;     // positional correction factor
const REST_SPEED = 45;       // below this normal impact speed -> no restitution
const VELOCITY_LIMIT = 14000; // px/s clamp for stability
const ANG_LIMIT = 40;        // rad/s clamp

// Deterministic RNG for VISUAL effects only (never affects physics).
let rngState = 0x9e3779b9;
function rand01(){
  rngState = (rngState * 1664525 + 1013904223) >>> 0;
  return rngState / 4294967296;
}

function makeState(){
  const P = { ...DEFAULTS };
  readSliders(P);
  return {
    P, bodies: [], t: 0, running: false,
    car: null, camX: 0, camY: 0, camScale: 1, shake: 0,
    dust: [], skids: [], gy: 0, wallFrontX: 0, wallEndX: 0, carY: 0,
  };
}

// ---------- Body ----------
function createRect(x, y, w, h, mass, opts){
  opts = opts || {};
  const isStatic = !!opts.static;
  const boxH = opts.boxH || h;
  const I = isStatic ? 0 : (1/12) * mass * (w*w + boxH*boxH);
  return {
    x, y, w, h, boxH,
    vx: 0, vy: 0, va: 0, a: 0,
    mass: isStatic ? 0 : mass,
    invMass: isStatic ? 0 : 1/mass,
    invI: isStatic ? 0 : 1/I,
    hw: w/2, hh: boxH/2,
    static: isStatic,
    restitution: opts.restitution ?? 0.18,
    friction: opts.friction ?? 0.72,
    isCar: !!opts.isCar,
    color: opts.color || "#8a5a3c",
    top: opts.top || opts.color || "#a56a45",
    light: opts.light || "#a56a45",
  };
}

// world-space corners, ordered c0=(-hw,-hh), c1=(hw,-hh), c2=(hw,hh), c3=(-hw,hh)
function boxCorners(b){
  const c = Math.cos(b.a), s = Math.sin(b.a);
  const hx = b.hw, hy = b.hh, px = b.x, py = b.y;
  const lx = [ -hx,  hx,  hx, -hx ];
  const ly = [ -hy, -hy,  hy,  hy ];
  const O = b._c || (b._c = new Float64Array(8));
  for(let i=0;i<4;i++){
    O[2*i]   = px + lx[i]*c - ly[i]*s;
    O[2*i+1] = py + lx[i]*s + ly[i]*c;
  }
  return O;
}

// ---------- World ----------
function buildWorld(st){
  st.bodies.length = 0; st.dust.length = 0; st.skids.length = 0;
  const P = st.P, s = P.scale;

  st.gy = VH - 90;
  const groundY = st.gy;
  const brickW = P.brickW*s, brickH = P.brickH*s;
  const cols = P.cols, rows = P.rows;

  // depth layers sit behind each other (shifted +x). The car must push through
  // them one after another — real physical "thickness".
  const layerGap = brickW * 0.62;
  const extrude = Math.min(6 + P.depth*5, 26);
  const wallFrontX = VW - 300;
  st.wallFrontX = wallFrontX;
  st.wallEndX = wallFrontX + (P.depth-1)*layerGap + cols*brickW + extrude;

  const startIdx = 0;
  for(let d=0; d<P.depth; d++){
    const dx = d*layerGap;
    for(let r=0; r<rows; r++){
      const off = (r%2)*brickW*0.5;
      // stagger back layers oppositely so the wall interlocks like a real one
      const stag = (d%2===0) ? 1 : -1;
      for(let c=0; c<cols; c++){
        const bx = wallFrontX + dx + c*brickW + off*stag + brickW*0.5;
        const by = groundY - brickH*(r+1) + brickH*0.5;
        st.bodies.push(createRect(bx, by, brickW-1.2, brickH-1.2, P.brickMass, {
          restitution: P.brickRestitution, friction: P.brickFriction,
          color:"#8a5a3c", top:"#a56a45", light:"#c08a5c"
        }));
      }
    }
  }

  const carW = P.carW*s, carH = P.carH*s;
  const car = createRect(160 + carW*0.5, groundY - carH*0.5, carW, carH, P.carMass, {
    restitution: 0.35, friction: P.groundFriction, isCar:true,
    color:"#1f6feb", top:"#4c9aff", light:"#8fc6ff"
  });
  st.car = car;
  st.bodies.push(car);
  st.carY = groundY - carH*0.5;
}

// ---------- Collision detection: SAT + incident-face clipping ----------
// face normals (world) for the 4 faces, and their corner pairs
const FN = [ [ -1, 0 ], [ 1, 0 ], [ 0, -1 ], [ 0, 1 ] ]; // local outward normals (x,y)
// corner pairs per face index: 0=left(-x),1=right(+x),2=top(+y),3=bottom(-y)
// Using local normals, corners per face:
function faceCorners(idx, b){
  const c = Math.cos(b.a), s = Math.sin(b.a);
  const hx=b.hw, hy=b.hh, px=b.x, py=b.y;
  const L = [ [[-hx,-hy],[-hx,hy]], [[hx,-hy],[hx,hy]], [[-hx,-hy],[hx,-hy]], [[-hx,hy],[hx,hy]] ];
  const a=L[idx][0], d=L[idx][1];
  const rx=(x,y)=>px+x*c-y*s, ry=(x,y)=>py+x*s+y*c;
  return { p0:{x:rx(a[0][0],a[1][0]), y:ry(a[0][0],a[1][0])},
           p1:{x:rx(d[0][0],d[1][0]), y:ry(d[0][0],d[1][0])} };
}
function worldNormal(b, idx){
  const c=Math.cos(b.a), s=Math.sin(b.a);
  const lx=FN[idx][0], ly=FN[idx][1];
  return { x: lx*c - ly*s, y: lx*s + ly*c }; // rotate local normal
}

function projectBox(b, ax, ay){
  const ux = ax, uy = ay;
  const cx = b.x*ux + b.y*uy;
  const ex = b.hw*(Math.abs(b.cos*ux + b.sin*uy)) + b.hh*(Math.abs(-b.sin*ux + b.cos*uy));
  return { min: cx - ex, max: cx + ex };
}

function collide(a, b){
  const cosA=Math.cos(a.a), sinA=Math.sin(a.a);
  a.cos=cosA; a.sin=sinA;
  const cosB=Math.cos(b.a), sinB=Math.sin(b.a);
  b.cos=cosB; b.sin=sinB;

  let best = Infinity, refBody=null, refIdx=-1, refN=null;
  const bodies=[a,b];
  for(let bi=0; bi<2; bi++){
    const box = bodies[bi];
    for(let f=0; f<4; f++){
      const n = worldNormal(box, f);
      const pa = projectBox(a, n.x, n.y);
      const pb = projectBox(b, n.x, n.y);
      const overlap = Math.min(pa.max, pb.max) - Math.max(pa.min, pb.min);
      if(overlap <= 0) return null;           // separated on this axis
      if(overlap < best){ best = overlap; refBody = bi; refIdx = f; refN = {x:n.x,y:n.y}; }
    }
  }
  if(refBody === null) return null;
  // reference face
  const refBox = bodies[refBody];
  const f = faceCorners(refIdx, refBox);
  const n = (refBody===0) ? {x:refN.x,y:refN.y} : {x:-refN.x,y:-refN.y};
  // incident body & face (most anti-parallel to n)
  const incBox = bodies[refBody===0?1:0];
  let incBest=-Infinity, incIdx=-1;
  for(let f2=0; f2<4; f2++){
    const nn = worldNormal(incBox, f2);
    const dot = nn.x*n.x + nn.y*n.y;
    if(dot > incBest){ incBest=dot; incIdx=f2; }
  }
  const inc = faceCorners(incIdx, incBox);

  // clip incident segment against reference face planes
  const s = Math.hypot(f.p1.x-f.p0.x, f.p1.y-f.p0.y) || 1;
  const sx = (f.p1.x-f.p0.x)/s, sy=(f.p1.y-f.p0.y)/s; // face direction
  let pts = [ inc.p0, inc.p1 ];
  // plane 0: reference face plane, normal n, keep points behind (dot(n,p) <= offset)
  const off = n.x*f.p0.x + n.y*f.p0.y;
  pts = clip(pts, n.x, n.y, off);
  if(pts.length < 1) return null;
  // side planes through f.p0 (normal +s) and f.p1 (normal -s)
  pts = clip(pts, sx, sy, sx*f.p0.x + sy*f.p0.y);
  if(pts.length < 1) return null;
  pts = clip(pts, -sx, -sy, -sx*f.p1.x - sy*f.p1.y);

  if(pts.length === 0) return null;
  let cx=0, cy=0;
  for(const p of pts){ cx+=p.x; cy+=p.y; }
  const ct = { x: cx/pts.length, y: cy/pts.length };
  return { n, depth: best, contacts:[ ct ] };
}

// clip segment [p0,p1] by plane: keep points with dot(n,p) <= offset + slop
function clip(pts, nx, ny, offset){
  const slop = SLOP;
  const out = [];
  for(let i=0;i<pts.length;i++){
    const p = pts[i];
    const d = nx*p.x + ny*p.y - offset;
    const p2 = pts[(i+1)%pts.length];
    const d2 = nx*p2.x + ny*p2.y - offset;
    if(d <= slop) out.push(p);
    if((d < 0) !== (d2 < 0)){
      const t = d/(d-d2);
      out.push({ x: p.x + t*(p2.x-p.x), y: p.y + t*(p2.y-p.y) });
    }
  }
  return out;
}

// ---------- Ground contact (static plane) ----------
function groundContact(b, gy){
  const O = boxCorners(b);
  // lowest point = corner with the largest y (y grows downward)
  let maxY = -Infinity;
  for(let i=0;i<4;i++){ const y=O[2*i+1]; if(y>maxY) maxY=y; }
  if(maxY <= gy) return null;
  const pts = [];
  for(let i=0;i<4;i++){
    const y=O[2*i+1];
    if(y >= maxY - 1.5) pts.push({ x:O[2*i], y });
  }
  if(pts.length === 0) return null;
  // normal points from the body (A) toward the ground (B): downward, so the
  // impulse pushes the body out of the plane (upward).
  return { n:{x:0,y:1}, depth: maxY - gy, contacts: pts };
}

// ---------- Impulse solver ----------
function crossX(w, r){ return { x: -w*r.y, y: w*r.x }; } // w (scalar) x r

function solveContact(a, b, c){
  const n = c.n;
  const mA=a.invMass, mB=b.invMass, iA=a.invI, iB=b.invI;
  if(mA + mB <= 0) return;

  for(const ct of c.contacts){
    const ra = { x: ct.x - a.x, y: ct.y - a.y };
    const rb = { x: ct.x - b.x, y: ct.y - b.y };
    const va = { x: a.vx + crossX(a.va, ra).x, y: a.vy + crossX(a.va, ra).y };
    const vb = { x: b.vx + crossX(b.va, rb).x, y: b.vy + crossX(b.va, rb).y };
    let rv = { x: vb.x - va.x, y: vb.y - va.y };
    let vn = rv.x*n.x + rv.y*n.y;
    if(vn > 0) continue;   // separating

    const ra_n = ra.x*n.y - ra.y*n.x;
    const rb_n = rb.x*n.y - rb.y*n.x;
    const km = mA + mB + iA*ra_n*ra_n + iB*rb_n*rb_n;
    if(km <= 0) continue;

    // restitution (no bounce for slow impacts to avoid resting jitter)
    const e = (vn < -REST_SPEED) ? Math.min(a.restitution, b.restitution) : 0;
    let jn = -(1 + e) * vn / km;
    a.vx -= jn*n.x*mA; a.vy -= jn*n.y*mA; a.va -= ra_n*jn*iA;
    b.vx += jn*n.x*mB; b.vy += jn*n.y*mB; b.va += rb_n*jn*iB;

    // friction (Coulomb, clamped) using post-normal point velocities
    const vat = { x: a.vx + crossX(a.va, ra).x, y: a.vy + crossX(a.va, ra).y };
    const vbt = { x: b.vx + crossX(b.va, rb).x, y: b.vy + crossX(b.va, rb).y };
    let rtv = { x: vbt.x - vat.x, y: vbt.y - vat.y };
    let tx = rtv.x, ty = rtv.y;
    const tl = Math.hypot(tx,ty);
    if(tl < 1e-7) continue;
    tx/=tl; ty/=tl;
    const rn_t = ra.x*ty - ra.y*tx, rb_t = rb.x*ty - rb.y*tx;
    const jt_raw = -(rtv.x*tx + rtv.y*ty) / (mA + mB + iA*rn_t*rn_t + iB*rb_t*rb_t);
    const cl = Math.abs(jn) * Math.sqrt(Math.min(a.friction, b.friction));
    let jt = jt_raw;
    if(jt > cl) jt = cl; else if(jt < -cl) jt = -cl;
    a.vx -= tx*jt*mA; a.vy -= ty*jt*mA; a.va -= rn_t*jt*iA;
    b.vx += tx*jt*mB; b.vy += ty*jt*mB; b.va += rb_t*jt*iB;
  }
}

// position-based overlap removal: shift bodies apart directly (dt-independent,
// energy-free). This is what actually keeps the stack from sinking through the
// ground or each other. Division uses the inverse-mass sum (no inertia terms),
// so each body moves proportionally to its mass.
function positionResolve(a, b, c){
  const n = c.n;
  const mA = a.invMass, mB = b.invMass;
  if(mA + mB <= 0) return;
  const s = POS_FACTOR * Math.max(c.depth - SLOP, 0) / (mA + mB);
  a.x -= n.x * s * mA; a.y -= n.y * s * mA;
  b.x += n.x * s * mB; b.y += n.y * s * mB;
}

// ---------- Broadphase (uniform spatial grid) ----------
function broadphase(st){
  const cell = 90;
  const grid = new Map();
  const B = st.bodies;
  for(let i=0;i<B.length;i++){
    const b=B[i];
    const cx=Math.floor(b.x/cell), cy=Math.floor(b.y/cell);
    for(let dx=-1;dx<=1;dx++)for(let dy=-1;dy<=1;dy++){
      const k=(cx+dx)*100000+(cy+dy);
      let g=grid.get(k); if(!g){g=[];grid.set(k,g);} g.push(i);
    }
  }
  const tested=new Set(), pairs=[];
  function add(i,j){ if(i!==j){ const key=i*100000+j; if(!tested.has(key)){tested.add(key); pairs.push([i,j]);} } }
  for(const [,arr] of grid){
    const n=arr.length;
    for(let p=0;p<n;p++) for(let q=p+1;q<n;q++) add(arr[p],arr[q]);
  }
  return pairs;
}

// ---------- Step ----------
const GRAV = DEFAULTS.gravity * DEFAULTS.scale;
const CAR_ACC = 15 * DEFAULTS.scale; // m/s^2 -> px/s^2

function step(st, dt){
  const P = st.P;
  const bodies = st.bodies;
  const car = st.car;

  // engine: accelerate toward target speed (real drive). Collision resolves the rest.
  if(car){
    const target = P.speed * P.scale;
    if(car.vx < target){
      car.vx = Math.min(target, car.vx + CAR_ACC*dt);
    } else if(car.vx > target){
      car.vx = target;
    }
    car.a *= 0.9; car.va *= 0.85; // keep car roughly level
    if(!isFinite(car.vx)) car.vx=0; if(!isFinite(car.vy)) car.vy=0;
  }

  // integrate
  for(const b of bodies){
    if(b.static) continue;
    b.vy += GRAV*dt;
    b.x += b.vx*dt;
    b.y += b.vy*dt;
    b.a += b.va*dt;
    b.va *= 0.999;
  }

  const pairs = broadphase(st);
  for(let it=0; it<SOLVER_IT; it++){
    for(const [i,j] of pairs){
      const a=bodies[i], b=bodies[j];
      if(a.invMass + b.invMass <= 0) continue;
      const c = collide(a,b);
      if(c){
        solveContact(a,b,c);
        if(st.running && it===0){
          const rel = Math.hypot(b.vx-a.vx, b.vy-a.vy);
          if(rel > 300) onImpact(c.contacts[0].x, c.contacts[0].y, rel, a.isCar||b.isCar);
        }
      }
    }
    // ground contacts
    for(const b of bodies){
      if(b.static) continue;
      const gc = groundContact(b, st.gy);
      if(gc) solveContact(b, groundBody, gc);
    }
  }

  // positional overlap removal (once, shifts positions directly)
  for(const [i,j] of pairs){
    const a=bodies[i], b=bodies[j];
    if(a.invMass + b.invMass <= 0) continue;
    const c = collide(a,b);
    if(c) positionResolve(a,b,c);
  }
  for(const b of bodies){
    if(b.static) continue;
    const gc = groundContact(b, st.gy);
    if(gc) positionResolve(b, groundBody, gc);
  }

  // velocity & angle clamps
  for(const b of bodies){
    if(b.static) continue;
    const sp=Math.hypot(b.vx,b.vy); if(sp>VELOCITY_LIMIT){ b.vx*=VELOCITY_LIMIT/sp; b.vy*=VELOCITY_LIMIT/sp; }
    if(Math.abs(b.a)>1.6){ b.a=Math.sign(b.a)*1.6; }
    if(Math.abs(b.va)>ANG_LIMIT){ b.va=Math.sign(b.va)*ANG_LIMIT; }
  }
  if(car){ const sp=Math.hypot(car.vx,car.vy); if(sp>VELOCITY_LIMIT){ car.vx*=VELOCITY_LIMIT/sp; } }

  st.t += dt;
}

// ---------- Static ground body (for contact solver) ----------
const groundBody = createRect(0, 0, 1, 1, 0, { static:true, friction:0.85, restitution:0.0 });

// ---------- Effects ----------
function onImpact(x,y,rel,isCar){
  if(S.dust.length > 320) return;
  S.shake = Math.min(S.shake + rel*0.014, 26);
  const n = isCar ? 14 : 6;
  for(let k=0;k<n;k++){
    const ang = rand01()*Math.PI - Math.PI*0.5, spd = 70 + rand01()*170;
    S.dust.push({
      x, y, vx:Math.cos(ang)*spd, vy:-Math.abs(Math.sin(ang))*spd*0.7 - 30,
      life:0.25+rand01()*0.25, max:0.5, r:1.5+rand01()*2.6, dust: rand01()<0.55
    });
  }
  if(isCar) S.skids.push({x,y,life:1.6,max:1.6});
}
function updateParticles(dt){
  for(let i=S.dust.length-1;i>=0;i--){
    const p=S.dust[i]; p.life-=dt; if(p.life<=0){ S.dust.splice(i,1); continue; }
    p.vy += GRAV*dt*0.45; p.x += p.vx*dt; p.y += p.vy*dt; p.vx *= 0.96;
  }
  for(let i=S.skids.length-1;i>=0;i--){ const p=S.skids[i]; p.life-=dt; if(p.life<=0) S.skids.splice(i,1); }
}

// ---------- Rendering ----------
function drawGround(gy){
  const cs = (S && S.camScale) ? S.camScale : 1;
  const margin = 400 / cs;
  const worldW = (VW / cs) + margin * 2;
  const grad = ctx.createLinearGradient(0,gy,0,gy + (VH/cs) + 200);
  grad.addColorStop(0,"#3a424b"); grad.addColorStop(1,"#1a1f26");
  ctx.fillStyle=grad; ctx.fillRect(-margin, gy, worldW, (VH/cs) + 200);
  ctx.fillStyle="#4a5560"; ctx.fillRect(-margin, gy, worldW, 3);
  ctx.fillStyle="#3f7d45"; ctx.fillRect(-margin, gy-7, worldW, 4);
  // road markings
  ctx.fillStyle="rgba(255,255,255,.12)";
  for(let x=-margin; x<margin+worldW; x+=120){ ctx.fillRect(x, gy+26, 60, 3); }
}

function shade(hex, amt){
  const m = hex.match(/#([0-9a-f]{6})/i); if(!m) return hex;
  const r=parseInt(m[1].substr(0,2),16), g=parseInt(m[1].substr(2,2),16), b=parseInt(m[1].substr(4,2),16);
  const f=t=>Math.max(0,Math.min(255,Math.round(t+amt)));
  return "rgb("+f(r)+","+f(g)+","+f(b)+")";
}

function drawBox(b, depthL){
  const v = boxCorners(b);
  const ex = Math.min(5 + depthL*4, 20);
  const dx = -ex*0.55, dy = -ex;
  ctx.save();
  // depth slab (right + top faces) to suggest thickness
  ctx.fillStyle = shade(b.color, -46);
  ctx.beginPath(); ctx.moveTo(v[1].x,v[1].y); ctx.lineTo(v[2].x,v[2].y);
  ctx.lineTo(v[2].x+dx,v[2].y+dy); ctx.lineTo(v[1].x+dx,v[1].y+dy); ctx.closePath(); ctx.fill();
  ctx.fillStyle = shade(b.color, -26);
  ctx.beginPath(); ctx.moveTo(v[2].x,v[2].y); ctx.lineTo(v[3].x,v[3].y);
  ctx.lineTo(v[3].x+dx,v[3].y+dy); ctx.lineTo(v[2].x+dx,v[2].y+dy); ctx.closePath(); ctx.fill();
  // front face
  ctx.fillStyle = b.top;
  ctx.beginPath(); ctx.moveTo(v[0].x,v[0].y);
  for(let i=1;i<4;i++) ctx.lineTo(v[i].x,v[i].y); ctx.closePath(); ctx.fill();
  // mortar outline
  ctx.strokeStyle = shade(b.top, -60); ctx.lineWidth = 1; ctx.stroke();
  // top highlight edge
  ctx.strokeStyle = "rgba(255,255,255,.16)"; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(v[0].x,v[0].y); ctx.lineTo(v[1].x,v[1].y); ctx.stroke();
  // brick texture lines (running bond hint)
  ctx.strokeStyle = "rgba(0,0,0,.10)";
  ctx.beginPath();
  const mx=(v[0].x+v[2].x)/2, my=(v[0].y+v[2].y)/2;
  ctx.moveTo(mx, v[0].y); ctx.lineTo(mx, v[2].y); ctx.stroke();
  ctx.restore();
}

function drawCar(car){
  const w=car.w, h=car.h, hw=w/2, hh=h/2;
  ctx.save();
  ctx.translate(car.x, car.y); ctx.rotate(car.a);
  ctx.fillStyle="rgba(0,0,0,.35)";
  ctx.beginPath(); ctx.ellipse(0, hh*0.95, hw*0.95, 7, 0, 0, Math.PI*2); ctx.fill();
  const pts=[ [-hw*0.98,hh*0.30],[-hw*0.98,hh*0.05],[-hw*0.30,-hh*0.30],[-hw*0.18,-hh*0.62],
    [hw*0.20,-hh*0.64],[hw*0.40,-hh*0.28],[hw*0.70,-hh*0.06],[hw*0.95,hh*0.18],
    [hw*0.90,hh*0.42],[-hw*0.90,hh*0.42] ];
  const g=ctx.createLinearGradient(0,-hh,0,hh);
  g.addColorStop(0,"#5aa8ff"); g.addColorStop(0.35,"#2f7bff");
  g.addColorStop(0.75,"#1f6feb"); g.addColorStop(1,"#124db0");
  ctx.fillStyle=g;
  ctx.beginPath(); ctx.moveTo(pts[0][0],pts[0][1]);
  for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i][0],pts[i][1]);
  ctx.closePath(); ctx.fill();
  ctx.strokeStyle="rgba(255,255,255,.35)"; ctx.lineWidth=2;
  ctx.beginPath(); ctx.moveTo(-hw*0.9,hh*0.06); ctx.lineTo(hw*0.66,hh*0.0); ctx.stroke();
  ctx.fillStyle="#12223a";
  ctx.beginPath(); ctx.moveTo(-hw*0.24,-hh*0.26); ctx.lineTo(hw*0.17,-hh*0.56);
  ctx.lineTo(hw*0.34,-hh*0.26); ctx.closePath(); ctx.fill();
  ctx.fillStyle="rgba(120,190,255,.65)";
  ctx.beginPath(); ctx.moveTo(-hw*0.16,-hh*0.24); ctx.lineTo(hw*0.10,-hh*0.46);
  ctx.lineTo(hw*0.10,-hh*0.24); ctx.closePath(); ctx.fill();
  ctx.beginPath(); ctx.moveTo(hw*0.16,-hh*0.42); ctx.lineTo(hw*0.30,-hh*0.24);
  ctx.lineTo(hw*0.16,-hh*0.24); ctx.closePath(); ctx.fill();
  ctx.fillStyle="#fff6cf";
  ctx.beginPath(); ctx.moveTo(hw*0.86,hh*0.12); ctx.lineTo(hw*0.96,hh*0.16);
  ctx.lineTo(hw*0.96,hh*0.26); ctx.lineTo(hw*0.86,hh*0.22); ctx.closePath(); ctx.fill();
  ctx.fillStyle="#ff5a5a"; ctx.fillRect(-hw*0.99,hh*0.02,4,12);
  ctx.strokeStyle="rgba(10,30,60,.45)"; ctx.lineWidth=1.5;
  ctx.beginPath(); ctx.moveTo(0,-hh*0.22); ctx.lineTo(0,hh*0.32); ctx.stroke();
  wheelAt(hw*0.5, hh*0.46, hh*0.46); wheelAt(-hw*0.5, hh*0.46, hh*0.46);
  ctx.restore();
}
function wheelAt(x,y,r){
  ctx.save();
  ctx.beginPath(); ctx.arc(x,y,r,0,Math.PI*2); ctx.fillStyle="#111"; ctx.fill();
  ctx.beginPath(); ctx.arc(x,y,r*0.55,0,Math.PI*2); ctx.fillStyle="#9aa4af"; ctx.fill();
  ctx.beginPath(); ctx.arc(x,y,r*0.28,0,Math.PI*2); ctx.fillStyle="#5c6670"; ctx.fill();
  ctx.strokeStyle="#3a444e"; ctx.lineWidth=2;
  for(let k=0;k<5;k++){ const a=k/5*Math.PI*2; ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x+Math.cos(a)*r*0.5,y+Math.sin(a)*r*0.5); ctx.stroke(); }
  ctx.restore();
}
function drawDust(p){
  const a=Math.max(0,p.life/p.max);
  ctx.fillStyle = p.dust ? "rgba(190,180,160,"+a*0.4+")" : "rgba(225,220,210,"+a*0.32+")";
  ctx.beginPath(); ctx.arc(p.x,p.y,p.r*(0.5+a),0,Math.PI*2); ctx.fill();
}
let citySeed=[0.2,0.5,0.35,0.7,0.45,0.6,0.3,0.8,0.55,0.4];
function drawCityscape(){
  ctx.fillStyle="#0c141c";
  for(let i=0;i<10;i++){
    const x=i*(VW/10), h=80+citySeed[i%citySeed.length]*150;
    ctx.fillRect(x+8, VH-90-h, VW/10-20, h);
  }
  // windows
  ctx.fillStyle="rgba(120,160,210,.06)";
  for(let i=0;i<10;i++){
    const x=i*(VW/10), h=80+citySeed[i%citySeed.length]*150;
    for(let wy=VH-90-h+12; wy<VH-100; wy+=18){
      for(let wx=x+14; wx<x+VW/10-16; wx+=18){ if((wx+wy)%3) ctx.fillRect(wx,wy,6,8); }
    }
  }
}

// Frame the whole scene (track + wall + debris headroom) so it always fits.
function frameCamera(st){
  const margin = VW*0.05;
  const worldLeft = -60;
  const worldRight = st.wallEndX + 140; // headroom for flying debris
  const worldW = worldRight - worldLeft;
  const target = (VW - 2*margin) / worldW;
  st.camScale = Math.max(0.35, Math.min(1.0, target));
  // keep the ground line ~82% down the screen
  const groundScreenY = VH*0.82;
  const s = st.camScale;
  st.camX = margin - worldLeft*s;
  st.camY = groundScreenY - st.gy*s;
}

function render(){
  ctx.clearRect(0,0,VW,VH);
  const sky=ctx.createLinearGradient(0,0,0,VH);
  sky.addColorStop(0,"#0f1720"); sky.addColorStop(0.6,"#15202b"); sky.addColorStop(1,"#1b2430");
  ctx.fillStyle=sky; ctx.fillRect(0,0,VW,VH);
  drawCityscape();

  let cx=0, cy=0;
  if(S && S.shake>0){
    S.shake*=0.85;
    cx=(rand01()-0.5)*S.shake; cy=(rand01()-0.5)*S.shake;
  }
  ctx.save();
  // shake in screen space, then camera framing in world space
  ctx.translate(cx, cy);
  if(S){
    frameCamera(S);
    ctx.scale(S.camScale, S.camScale);
    ctx.translate(S.camX, S.camY);
  }

  if(S){
    const gy=S.gy;
    drawGround(gy);
    // skid marks (drawn in world space)
    for(const p of S.skids){
      const a=Math.max(0,p.life/p.max)*0.5;
      ctx.fillStyle="rgba(18,18,18,"+a+")";
      ctx.fillRect(p.x-3, p.y-1, 6, 3);
    }
    const depth=S.P.depth;
    let drewCar=false;
    // draw back layers / bricks behind car first
    for(const b of S.bodies){
      if(b.isCar) continue;
      if(!drewCar && b.y < S.car.y){ drawCar(S.car); drewCar=true; }
      drawBox(b, depth);
    }
    if(!drewCar) drawCar(S.car);
    for(const p of S.dust) drawDust(p);

    // distance marker to wall
    const carN = S.car.x + S.car.w/2;
    const gap = (S.wallFrontX + 20) - carN;
    if(gap > 10){
      ctx.fillStyle="rgba(230,237,243,.6)"; ctx.font="bold 11px system-ui";
      ctx.fillText("Mur: "+(gap/S.P.scale).toFixed(1)+" m", carN-30, S.carY - S.car.h/2 - 22);
    }
  }
  ctx.restore();
}

// ---------- Telemetry ----------
const el = { speed:document.getElementById("tSpeed"), time:document.getElementById("tTime"), move:document.getElementById("tMove"), fps:document.getElementById("fps") };
function telemetry(){
  if(!S) return;
  const car=S.car;
  const spd = car ? Math.hypot(car.vx,car.vy)/S.P.scale : 0;
  el.speed.innerHTML = spd.toFixed(1)+' <span>m/s</span>';
  el.time.innerHTML = S.t.toFixed(2)+' <span>s</span>';
  let moving=0, total=0;
  for(const b of S.bodies){ if(b.static||b.isCar) continue; total++; if(Math.hypot(b.vx,b.vy)>8) moving++; }
  el.move.innerHTML = moving+' <span>/ '+total+'</span>';
}

// ---------- Main loop ----------
let last=performance.now(), acc=0, fpsAccum=0, fpsFrames=0, fpsTimer=0;
const FIXED=1/60;
function frame(now){
  let dt=(now-last)/1000; last=now;
  if(dt>0.05) dt=0.05;
  if(S && S.running){
    acc += dt; let guard=0;
    while(acc>=FIXED && guard<6){
      for(let s=0;s<SUBSTEPS;s++) step(S, FIXED/SUBSTEPS);
      S.t += FIXED; acc -= FIXED; guard++;
    }
    if(guard>=6) acc=0;
    updateParticles(dt);
  }
  render(); telemetry();
  // fps
  fpsTimer += dt; fpsFrames++;
  if(fpsTimer>=0.5){ el.fps.textContent = Math.round(fpsFrames/fpsTimer)+" fps · " + (S?S.bodies.length:0)+" corps"; fpsTimer=0; fpsFrames=0; }
  requestAnimationFrame(frame);
}

// ---------- UI ----------
const sliders={ speed:document.getElementById("speed"), cols:document.getElementById("cols"),
  rows:document.getElementById("rows"), depth:document.getElementById("depth"), mass:document.getElementById("mass") };
const labels={ speed:document.getElementById("vSpeed"), cols:document.getElementById("vCol"),
  rows:document.getElementById("vRow"), depth:document.getElementById("vDepth"), mass:document.getElementById("vMass") };
function readSliders(P){
  P.speed=+sliders.speed.value; P.cols=+sliders.cols.value; P.rows=+sliders.rows.value;
  P.depth=+sliders.depth.value; P.brickMass=+sliders.mass.value;
}
function refreshLabels(){ for(const k in labels) labels[k].textContent=sliders[k].value; }
for(const k in sliders) sliders[k].addEventListener("input", ()=>{ refreshLabels(); if(!S||!S.running) prebuild(); });
document.getElementById("menuBtn").addEventListener("click", ()=> document.getElementById("settings").classList.toggle("show"));
document.getElementById("test").addEventListener("click", startTest);
document.getElementById("reset").addEventListener("click", ()=> prebuild());

function settleWorld(st){
  st.running=false;
  for(let i=0;i<320;i++) step(st, FIXED/SUBSTEPS);
  for(const b of st.bodies){ if(b.static) continue; b.vx=0; b.vy=0; b.va=0; b.va=0; }
}
function prebuild(){
  rngState=0x9e3779b9;
  const st=makeState(); buildWorld(st); settleWorld(st); S=st; setBadge("configuré");
}
function setBadge(t){ document.getElementById("runBadge").textContent=t; }
function startTest(){
  rngState=0x9e3779b9;
  S=makeState(); buildWorld(S); settleWorld(S);
  S.running=true; S.t=0; acc=0; S.camX=0; setBadge("en cours…");
  document.getElementById("test").disabled=true;
  setTimeout(()=>document.getElementById("test").disabled=false, 900);
}

refreshLabels();
prebuild();
requestAnimationFrame(frame);

// debug hook for headless verification
window.__crash = {
  get running(){ return S ? S.running : false; },
  get car(){ return S ? S.car : null; },
  get bodies(){ return S ? S.bodies : []; },
  get gy(){ return S ? S.gy : 0; },
  __groundContact: groundContact,
  __solve: solveContact,
  __collide: collide,
  __boxCorners: boxCorners,
  __ground: groundBody,
  __gy(){ return S ? S.gy : 0; },
  __body(i){ return S ? S.bodies[i] : null; },
  __n(){ return S ? S.bodies.length : 0; },
};
</script>
</body>
</html>
